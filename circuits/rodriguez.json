    "guide": {
        "summary": "Thin air, a baseball stadium in the middle of the lap and the loudest podium of the year.",
        "character": "At about 2,240 metres above sea level, cars make less downforce and struggle to cool their engines and brakes. Teams run Monaco-level wings and still pass 350 km/h on the long main straight. The lap ends through the Foro Sol stadium.",
        "corners": [
            {
                "name": "Foro Sol (stadium section)",
                "famous": true,
                "note": "Slow and twisty, with grandstands all round. The podium is here too."
            },
            {
                "name": "Peraltada",
                "famous": true,
                "note": "Once a fearsome banked final corner. Since 2015 the lap cuts through the stadium instead, and only the end of the banking is left."
            }
        ],
        "moments": [
            {
                "season": 1970,
                "title": "The crowd on the track",
                "body": "In 1970 fans crowded right up to the edge of the track. The start was delayed while officials and drivers, Pedro Rodríguez among them, tried to move people back. Mexico didn't host another Grand Prix for 16 years.",
                "video": "https://www.youtube.com/watch?v=0gKVnu-2Clo"
            }
        ],
        "history": [
            {
                "period": "1963",
                "body": "First World Championship race. The track is named after Mexico's racing brothers, Ricardo and Pedro Rodríguez."
            },
            {
                "period": "1986-1992",
                "body": "Back on the calendar, with the full Peraltada."
            },
            {
                "period": "2015",
                "body": "Returned after 23 years on a reworked layout that runs through a stadium."
            },
            {
                "period": "2021",
                "body": "Renamed the Mexico City Grand Prix."
            }
        ]
    },
