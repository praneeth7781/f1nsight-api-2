    "guide": {
        "summary": "Old city walls, a 2 km flat-out run along the seafront and a corner barely wider than a car.",
        "character": "Two tracks in one: a tight, walled section through the old city, then a full-throttle run down Neftchilar Avenue where the slipstream makes passing easy. Safety cars are almost guaranteed.",
        "corners": [
            {
                "name": "Castle section (Turn 8)",
                "famous": true,
                "note": "Uphill past the old city walls and about 7.6 m wide. Two cars don't fit. People still try."
            },
            {
                "name": "Neftchilar Avenue",
                "famous": true,
                "note": "The long flat-out run to the line. The leader gets towed along and whoever's chasing gets a chance."
            }
        ],
        "moments": [
            {
                "season": 2017,
                "title": "Vettel hits Hamilton behind the safety car",
                "body": "Sebastian Vettel thought Lewis Hamilton had brake-tested him and drove into the side of his car. Vettel got a stop-go penalty, Hamilton had to pit for a loose headrest, and Daniel Ricciardo won from 10th on the grid.",
                "video": "https://www.youtube.com/watch?v=ANK91305IVg"
            }
        ],
        "history": [
