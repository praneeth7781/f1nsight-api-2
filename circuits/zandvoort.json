    "guide": {
        "summary": "Sand dunes, banked corners and an orange crowd that doesn't stop singing.",
        "character": "Narrow and old-school, with steep banking added for the 2021 return. Overtaking is hard, so qualifying matters a lot. Sand from the dunes blows onto the track.",
        "corners": [
            {
                "name": "Turn 3 (Hugenholtzbocht)",
                "famous": true,
                "note": "A right-hander banked at about 19 degrees, so drivers can take several different lines."
            },
            {
                "name": "Turn 14 (Arie Luyendykbocht)",
                "famous": true,
                "note": "The banked final corner, about 18 degrees, taken flat out onto the main straight."
            }
        ],
        "moments": [
            {
                "season": 1979,
                "title": "Villeneuve on three wheels",
                "body": "When his left rear tyre failed in 1979, Gilles Villeneuve drove his Ferrari back to the pits at speed with the wheel hanging off. He retired anyway.",
                "video": "https://www.youtube.com/watch?v=9ZuZ-pcobCM"
            }
        ],
        "history": [
            {
                "period": "1952",
                "body": "First World Championship race."
            },
            {
                "period": "1985",
                "body": "Last race of its first spell on the calendar."
            },
            {
                "period": "2021",
                "body": "Back after 36 years, with steep banking added."
            },
            {
                "period": "2026",
                "body": "Billed as the last Dutch Grand Prix for now."
            }
        ]
    },
