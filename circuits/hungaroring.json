    "guide": {
        "summary": "Monaco without the walls: tight, twisty and hot, with almost nowhere to pass.",
        "character": "Slow corners one after another, so teams bring maximum downforce. It's dusty off the racing line, often very hot, and hard to overtake on, so strategy and qualifying decide a lot.",
        "corners": [
            {
                "name": "Turn 1",
                "famous": true,
                "note": "Downhill right at the end of the main straight. The main chance to overtake."
            },
            {
                "name": "Turn 4",
                "famous": true,
                "note": "A fast, blind left over a crest. Easy in a good car, scary in a bad one."
            }
        ],
        "moments": [
            {
                "season": 1997,
                "title": "Hill nearly wins in an Arrows",
                "body": "Reigning champion Damon Hill led most of the 1997 race in a usually slow Arrows. A hydraulic problem slowed him in the closing laps, and Jacques Villeneuve passed him on the last lap. Hill finished second."
            }
        ],
        "history": [
            {
                "period": "1986",
                "body": "First F1 race behind the Iron Curtain."
            },
            {
                "period": "2003",
                "body": "Lengthened to 4.381 km, with a longer main straight."
            },
            {
                "period": "2006",
                "body": "Jenson Button's first win, in the wet."
            }
        ]
    },
