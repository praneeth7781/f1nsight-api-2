    "guide": {
        "summary": "Seven kilometres of Belgian forest, weather that changes from one corner to the next, and Eau Rouge.",
        "character": "The longest lap on the calendar, with big climbs and drops and long full-throttle runs. It can rain at one end of the track and stay dry at the other. Teams cut downforce for the straights and then struggle in the twisty middle sector.",
        "corners": [
            {
                "name": "Eau Rouge / Raidillon",
                "famous": true,
                "note": "Downhill left, a compression, then uphill right, all flat out. The most famous corners in racing."
            },
            {
                "name": "Pouhon",
                "famous": true,
                "note": "A fast downhill left with two apexes. Where brave drivers find time."
            },
            {
                "name": "La Source",
                "famous": false,
                "note": "The Turn 1 hairpin. Tight, and lap one usually involves contact."
            },
            {
                "name": "Les Combes",
                "famous": false,
                "note": "The end of the Kemmel straight and the main overtaking spot."
            },
            {
                "name": "Blanchimont and the Bus Stop",
                "famous": false,
                "note": "A very fast left, then the slow chicane that ends the lap."
            }
        ],
        "moments": [
            {
                "season": 2000,
                "title": "Häkkinen's pass at 300 km/h",
                "body": "Mika Häkkinen and Michael Schumacher went either side of Ricardo Zonta's BAR on the Kemmel straight. Häkkinen took the inside line, the lead and the win.",
                "video": "https://www.youtube.com/watch?v=hyW1aT2utc0"
            }
        ],
        "history": [
            {
                "period": "1950",
                "body": "Part of the first World Championship season, on a 14 km road course through three villages."
            },
            {
                "period": "1970",
                "body": "Last race on the old circuit, which had become too fast to be safe."
            },
            {
                "period": "1983",
                "body": "F1 returned on the shortened 7 km layout."
            },
            {
                "period": "2007",
                "body": "The Bus Stop chicane was redesigned, giving today's 7.004 km lap."
            }
        ]
    },
