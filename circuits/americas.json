    "guide": {
        "summary": "America's purpose-built F1 track: a steep hill up to Turn 1 and corners modelled on other famous tracks.",
        "character": "A steep climb to the Turn 1 hairpin, then a run of fast esses modelled on Silverstone's Maggotts and Becketts. The track is famously bumpy. Wide corners let drivers try different lines.",
        "corners": [
            {
                "name": "Turn 1",
                "famous": true,
                "note": "Steep uphill hairpin with a blind apex, wide enough that half the field tries to fit into it at once."
            },
            {
                "name": "Turns 3-6",
                "famous": true,
                "note": "Fast esses based on Silverstone's Maggotts and Becketts."
            }
        ],
        "moments": [
            {
                "season": 2015,
                "title": "Hamilton's third title",
                "body": "Lewis Hamilton won in Austin in 2015 to wrap up his third championship with three races to spare.",
                "video": "https://www.youtube.com/watch?v=8CLkOr5P_ZA"
            }
        ],
        "history": [
            {
                "period": "2012",
                "body": "First race, bringing F1 back to the United States after five years away."
            },
            {
                "period": "2020",
                "body": "Cancelled during the pandemic."
            },
            {
                "period": "2023",
                "body": "Joined by Miami and Las Vegas: three US races in one season."
            }
        ]
