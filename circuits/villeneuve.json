    "guide": {
        "summary": "A track on an island in the St. Lawrence River, with a wall that has caught several world champions.",
        "character": "Long straights linked by chicanes and a hairpin, so braking and traction are what count. The walls sit close to the kerbs and punish small mistakes. The local groundhogs sometimes get involved too.",
        "corners": [
            {
                "name": "Wall of Champions",
                "famous": true,
                "note": "The wall on the exit of the final chicane. In 1999 it caught Damon Hill, Michael Schumacher and Jacques Villeneuve in the same race."
            },
            {
                "name": "The Hairpin (Turn 10)",
                "famous": true,
                "note": "The slowest corner, at the end of a straight. Good for overtaking and for locking up."
            }
        ],
        "moments": [
            {
                "season": 1999,
                "title": "The Wall of Champions gets its name",
                "body": "Three world champions crashed into the same wall on the exit of the last chicane in 1999. Montreal has called it the Wall of Champions ever since.",
                "video": "https://www.youtube.com/watch?v=Hffk64uP8u0"
            }
        ],
        "history": [
            {
                "period": "1978",
                "body": "First race, and Gilles Villeneuve's first Grand Prix win."
            },
            {
                "period": "1982",
                "body": "Named after Gilles Villeneuve, who died earlier that year."
            },
            {
                "period": "2011",
                "body": "The longest race in F1 history: over four hours with a long rain stoppage. Jenson Button won after passing Sebastian Vettel on the last lap."
            }
        ]
    },
