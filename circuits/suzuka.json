    "guide": {
        "summary": "A figure-of-eight track that drivers love and that has decided plenty of championships.",
        "character": "The only figure-of-eight on the calendar, crossing itself on a bridge. The esses in the first sector need perfect rhythm, and 130R is taken flat out.",
        "corners": [
            {
                "name": "S Curves",
                "famous": true,
                "note": "Snaking esses after Turn 2. One mistake spoils the whole sequence."
            },
            {
                "name": "130R",
                "famous": true,
                "note": "A fast left with a 130 m radius, now taken flat out."
            }
        ],
        "moments": [
            {
                "season": 1989,
                "title": "Senna and Prost collide",
                "body": "In 1989 Alain Prost turned in on Ayrton Senna at the chicane. Senna rejoined and won but was disqualified for cutting the chicane, so Prost was champion. In 1990 Senna drove into Prost at Turn 1 to win the title.",
                "video": "https://www.youtube.com/watch?v=WBForKcFWoA"
            }
        ],
        "history": [
            {
                "period": "1962",
                "body": "Built by Honda as a test track."
            },
            {
                "period": "1987",
                "body": "First Formula 1 race."
            },
            {
                "period": "2007-2008",
                "body": "The Japanese GP moved to Fuji, then came back to Suzuka in 2009."
            }
        ]
    },
