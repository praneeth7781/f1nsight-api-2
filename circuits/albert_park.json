    "guide": {
        "summary": "A park in Melbourne that becomes a race track once a year and then goes back to being a park.",
        "character": "Public roads round Albert Park Lake, made smoother and faster by the 2022 rework that removed the old Turn 9-10 chicane. Grip is low on Friday and builds all weekend. Lap one tends to be eventful.",
        "corners": [
            {
                "name": "Turns 9-10",
                "famous": true,
                "note": "The old chicane is gone. Now it's a flat-out left-right that needs a car that doesn't wriggle."
            },
            {
                "name": "Turn 1",
                "famous": true,
                "note": "Heavy braking at the end of the start straight. A popular place to lose a front wing on lap one."
            }
        ],
        "moments": [
            {
                "season": 2002,
                "title": "Webber scores on debut",
                "body": "Mark Webber finished fifth for Minardi in his first Grand Prix, at home. Points were so rare for Minardi that he and team boss Paul Stoddart celebrated on the podium after the race.",
                "video": "https://www.youtube.com/watch?v=E7-g_NkXNBI"
            }
        ],
        "history": [
            {
                "period": "1953 and 1956",
                "body": "Albert Park hosted the Australian Grand Prix decades before it became a championship round."
            },
            {
                "period": "1996",
                "body": "The Australian GP moved from Adelaide to Melbourne and took over as the usual season opener."
            },
            {
                "period": "2020",
                "body": "Cancelled on the morning of first practice as the pandemic arrived."
            },
            {
                "period": "2022",
                "body": "Reworked for better racing: wider corners, the Turn 9-10 chicane removed, 5.278 km."
            }
        ]
    },
