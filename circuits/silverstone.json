    "guide": {
        "summary": "A former airfield that held the first World Championship race and still has some of F1's fastest corners.",
        "character": "Fast and flowing. Copse, Maggotts, Becketts and Stowe reward downforce and commitment, and the wind across the old airfield changes how the car handles from lap to lap.",
        "corners": [
            {
                "name": "Copse",
                "famous": true,
                "note": "A right-hander taken flat out at close to 300 km/h."
            },
            {
                "name": "Maggotts and Becketts",
                "famous": true,
                "note": "Left-right-left-right at very high speed. Where a good car shows itself."
            }
        ],
        "moments": [
            {
                "season": 2008,
                "title": "Hamilton by over a minute",
                "body": "In heavy rain in 2008, Lewis Hamilton won by more than a minute and lapped everyone but the drivers who finished second and third.",
                "video": "https://www.youtube.com/watch?v=NE5ChDzQxbQ"
            }
        ],
        "history": [
            {
                "period": "1948",
                "body": "First British Grand Prix at the old wartime airfield."
            },
            {
                "period": "1950",
                "body": "Hosted the first ever World Championship race."
            },
            {
                "period": "1987",
                "body": "Became the permanent home of the British GP."
            },
            {
                "period": "2011",
                "body": "New pit building, the Wing, and today's 5.891 km layout."
            }
        ]
    },
