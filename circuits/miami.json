    "guide": {
        "summary": "A temporary track around the Miami Dolphins' stadium, with a marina that has no water.",
        "character": "Laid out in the car parks of Hard Rock Stadium. Three long straights give drivers chances to pass, and a slow, awkward chicane under a motorway bridge tests their patience. The boats in the marina sit on painted vinyl.",
        "corners": [
            {
                "name": "Turns 14-15 (overpass chicane)",
                "famous": true,
                "note": "Tight chicane under the motorway bridge. Slow, uphill and lined with walls."
            },
            {
                "name": "Turn 17",
                "famous": true,
                "note": "Hairpin at the end of the back straight. The best overtaking spot."
            }
        ],
