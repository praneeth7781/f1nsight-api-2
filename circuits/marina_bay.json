    "guide": {
        "summary": "F1's first night race: hot, humid and bumpy, and close to two hours long.",
        "character": "Slow street corners, heat and humidity make it one of the toughest races on drivers' bodies. Races often run close to the two-hour limit, and safety cars are common. A 2023 change took out four corners.",
        "corners": [
            {
                "name": "Turn 1",
                "famous": true,
                "note": "Hard braking at the end of the pit straight. The best place to pass."
            },
            {
                "name": "Turn 7",
                "famous": true,
                "note": "The end of Raffles Boulevard. The other overtaking spot, and a tight one to get right."
            },
            {
                "name": "The Padang section",
                "famous": false,
                "note": "Runs alongside the Padang playing field, past some of the city's oldest buildings."
            }
        ],
        "moments": [
            {
                "season": 2008,
                "title": "Crashgate",
                "body": "Nelson Piquet Jr. crashed on purpose to bring out a safety car that set up Fernando Alonso's win. It came out a year later, and team boss Flavio Briatore was banned (a court later overturned the ban).",
                "video": "https://www.youtube.com/watch?v=QTuGmXt8JVE"
            }
        ],
        "history": [
            {
                "period": "2008",
                "body": "First race, and F1's first night race."
            },
            {
                "period": "2020-2021",
                "body": "Cancelled during the pandemic."
            },
            {
                "period": "2023",
                "body": "Layout shortened from 23 to 19 corners, now 4.940 km."
            }
        ]
