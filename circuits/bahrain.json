    "guide": {
        "summary": "A desert circuit that races under floodlights and goes through rear tyres fast.",
        "character": "Long straights into heavy braking zones make overtaking easier than at most tracks. Rough tarmac and blown sand wear the rear tyres. The race starts at dusk, so the track cools as it goes on.",
        "corners": [
            {
                "name": "Turn 10",
                "famous": true,
                "note": "Downhill left that tightens while you're still braking. The likeliest place on the lap to lock a wheel."
            },
            {
                "name": "Turn 1",
                "famous": true,
                "note": "Hard stop at the end of the main straight. The best place to pass."
            }
        ],
        "moments": [
            {
                "season": 2020,
                "title": "Grosjean walks out of the fire",
                "body": "Romain Grosjean's Haas split in two against the barrier and caught fire on lap one. He climbed out after almost half a minute in the flames. The halo, which arrived in 2018, got most of the credit.",
                "video": "https://www.youtube.com/watch?v=ZQ7_En2xEm4"
            }
        ],
        "history": [
            {
                "period": "2004",
                "body": "First Formula 1 race in the Middle East."
            },
            {
                "period": "2010",
                "body": "Used the longer 6.299 km Endurance layout for one year. Nobody asked for it back."
            },
            {
                "period": "2014",
                "body": "First race under lights."
            },
            {
                "period": "2020",
                "body": "Two races in a row: the Bahrain GP, then the Sakhir GP on the 3.543 km outer loop, with laps under a minute."
            },
            {
                "period": "2026",
                "body": "The Bahrain Grand Prix was held at Sepang in Malaysia instead."
            }
        ]
    },
