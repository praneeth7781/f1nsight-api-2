    "guide": {
        "summary": "The usual season finale: an island track that races from sunset into the night, with a hotel over the circuit.",
        "character": "The race starts at sunset and finishes under floodlights. The 2021 rework took out slow chicanes to help overtaking.",
        "corners": [
            {
                "name": "Turn 5 (old Turn 7 hairpin)",
                "famous": true,
                "note": "Hairpin at the end of the first long straight. The main overtaking spot."
            },
            {
                "name": "Turn 9 (old Turns 11-14)",
                "famous": true,
                "note": "A banked left that replaced a run of slow chicanes in 2021."
            }
        ],
        "moments": [
            {
                "season": 2021,
                "title": "Decided on the last lap",
                "body": "After a late safety car restart, Max Verstappen passed Lewis Hamilton on the final lap to win his first title. Race director Michael Masi was replaced after the season.",
                "video": "https://www.youtube.com/watch?v=77RXPgDr-24"
            }
        ],
        "history": [
            {
                "period": "2009",
                "body": "First race, and F1's first race that started in daylight and finished at night."
            },
            {
                "period": "2014",
                "body": "Became the usual season finale."
            },
            {
                "period": "2021",
                "body": "Reworked layout, 5.281 km."
            }
        ]
    },
