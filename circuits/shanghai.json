    "guide": {
        "summary": "A track shaped like the Chinese character 'shang', with a first corner that seems to go on forever.",
        "character": "A long, ever-tightening Turn 1 and a 1.2 km back straight, one of the longest in F1. Front-left tyre wear is a constant theme.",
        "corners": [
            {
                "name": "Turns 1 and 2",
                "famous": true,
                "note": "A right-hander that keeps tightening for what feels like a minute."
            },
            {
                "name": "Turn 13",
                "famous": true,
                "note": "A long right onto the back straight. Get the exit right and you can pass into Turn 14."
            }
        ],
        "moments": [
            {
                "season": 2007,
                "title": "Hamilton stuck in the pit lane gravel",
                "body": "Leading the championship as a rookie, Lewis Hamilton stayed out on worn tyres and slid into the gravel at the pit lane entry. He lost the title by one point two weeks later.",
                "video": "https://www.youtube.com/watch?v=Jn69iYew9wQ"
            }
        ],
