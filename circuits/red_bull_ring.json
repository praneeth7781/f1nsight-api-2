    "guide": {
        "summary": "Ten corners in the Styrian hills: a short lap with big climbs and very small gaps.",
        "character": "One of the shortest laps of the year, so the field stays close and qualifying is tight. Long uphill straights end in heavy braking zones, and track limits cause trouble every year.",
        "corners": [
            {
                "name": "Turn 1 (Niki Lauda Kurve)",
                "famous": true,
                "note": "Uphill right after the start, named after Niki Lauda."
            },
            {
                "name": "Turn 3",
                "famous": true,
                "note": "A tight uphill right at the top of the hill. The main overtaking spot."
            }
        ],
        "moments": [
            {
                "season": 2002,
                "title": "Let Michael pass for the championship",
                "body": "Ferrari told Rubens Barrichello to let Michael Schumacher win. He moved over metres from the line, the crowd booed, and team orders were banned from 2003.",
                "video": "https://www.youtube.com/watch?v=2yHPQSOziDw"
            }
        ],
        "history": [
            {
                "period": "1970-1987",
                "body": "The fast, sweeping Österreichring."
            },
            {
                "period": "1997",
                "body": "Back as the shorter A1-Ring, the layout still raced today."
            },
            {
                "period": "2014",
                "body": "Returned as the Red Bull Ring after ten years away."
            },
            {
                "period": "2020",
                "body": "Hosted the first two races of the delayed season: the Austrian and Styrian GPs."
            }
        ]
    },
