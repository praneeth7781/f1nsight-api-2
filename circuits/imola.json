    "guide": {
        "summary": "Ferrari country: an anticlockwise circuit named after Enzo and Dino Ferrari.",
        "character": "Old-school: narrow and fast, with gravel close to the track and little room to pass. After 1994 chicanes slowed the fastest corners.",
        "corners": [],
        "moments": [
            {
                "season": 2005,
                "title": "Alonso holds off Schumacher",
                "body": "In 2005 Fernando Alonso kept a much faster Michael Schumacher behind him for the closing laps to win."
            }
        ],
        "history": [
            {
                "period": "1980",
                "body": "Hosted the Italian Grand Prix while Monza was being upgraded."
            },
            {
                "period": "1981-2006",
                "body": "Home of the San Marino Grand Prix."
            },
            {
                "period": "1994",
                "body": "Roland Ratzenberger and Ayrton Senna were killed in the same weekend. Chicanes followed in 1995."
            },
            {
                "period": "2020-2025",
                "body": "Back as the Emilia Romagna Grand Prix. The 2023 race was cancelled after floods."
            }
        ],
        "leftCalendar": "The San Marino GP was dropped after 2006. Imola came back for 2020-2025 and then left the calendar again from 2026."
    },
    "sources": [
        {
            "title": "Imola (San Marino GP) circuit guide",
