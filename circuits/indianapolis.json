    "guide": {
        "summary": "Home of the Indy 500, with a road course laid inside the oval for Formula 1.",
        "character": "An infield road course joined to part of the oval, so the lap ended with a flat-out run through the banked last corner and down the long front straight.",
        "corners": [],
        "moments": [
            {
                "season": 2005,
                "title": "Six cars on the grid",
                "body": "In 2005, Michelin's tyres weren't safe on the banking, so all 14 Michelin cars pulled into the pits after the formation lap. Six cars raced, and Michael Schumacher won."
            }
        ],
        "history": [
            {
                "period": "1950-1960",
                "body": "The Indy 500 counted for the World Championship, though almost no F1 regulars entered."
            },
            {
                "period": "2000",
                "body": "First United States Grand Prix on the road course."
            },
            {
                "period": "2007",
                "body": "Last race."
            }
        ],
        "leftCalendar": "The track and F1 couldn't agree terms after 2007. The US Grand Prix came back in 2012 at the Circuit of the Americas."
    },
