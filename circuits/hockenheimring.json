    "guide": {
        "summary": "The old Hockenheim: flat-out runs into the forest and back into a packed stadium.",
        "character": "Long straights through the forest broken up by chicanes, then a slow, twisty stadium section. Engines spent long stretches at full throttle.",
        "corners": [],
        "moments": [
            {
                "season": 2000,
                "title": "Barrichello wins from 18th",
                "body": "In 2000 Rubens Barrichello started 18th, stayed on dry tyres when rain fell on part of the track, and won his first Grand Prix."
            }
        ],
        "history": [
            {
                "period": "1970",
                "body": "First German Grand Prix at Hockenheim."
            },
            {
                "period": "1977",
                "body": "Became the German GP's regular home after F1 left the Nordschleife."
            },
            {
                "period": "2001",
                "body": "Last race through the forest."
            },
            {
                "period": "2002",
                "body": "Rebuilt as a shorter 4.574 km layout, raced on and off until 2019."
            }
        ],
        "leftCalendar": "The forest section was cut in 2002 for a shorter track with more grandstands. That newer layout hosted the German Grand Prix on and off until 2019."
    },
    "sources": [
        {
            "title": "Hockenheimring (Original Layout) circuit guide",
