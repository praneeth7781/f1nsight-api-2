    "guide": {
        "summary": "Anticlockwise and bumpy, with sudden rain and a crowd that turns races into chaos.",
        "character": "A short, fast lap run anticlockwise, with plenty of up and down. Rain can arrive with no warning, and the long uphill drag from Junção to the line sets up late passes.",
        "corners": [
            {
                "name": "Senna S",
                "famous": true,
                "note": "Downhill left-right straight after the start. The best overtaking spot."
            },
            {
                "name": "Junção",
                "famous": true,
                "note": "The last real corner before the climb to the line. A good exit here sets up a pass into the Senna S."
            }
        ],
        "moments": [
            {
                "season": 2008,
                "title": "Champion for 30 seconds",
                "body": "Felipe Massa won the race and was champion until Lewis Hamilton passed Timo Glock, who was on dry tyres in the rain, at the last corners. Fifth place gave Hamilton the title by one point.",
                "video": "https://www.youtube.com/watch?v=3pKsxtzfVbQ"
            }
        ],
        "history": [
            {
                "period": "1973",
                "body": "First World Championship race in Brazil."
            },
            {
                "period": "1978-1989",
                "body": "Brazil's race moved to Rio's Jacarepaguá for most of these years."
            },
            {
                "period": "1990",
                "body": "Back at Interlagos on a shortened layout of about 4.3 km."
            },
            {
                "period": "2021",
                "body": "Renamed the São Paulo Grand Prix."
            }
        ]
    },
