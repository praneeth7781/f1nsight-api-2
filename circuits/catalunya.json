    "guide": {
        "summary": "The track every team knows by heart, because for years it's where they all tested.",
        "character": "Fast sweeping corners, a long straight and a slow last sector, so it shows how good a car really is. Years of testing meant cars arrived perfectly set up and races were often processions. Taking out the final chicane in 2023 brought back the fast last corner.",
        "corners": [
            {
                "name": "Turn 3",
                "famous": true,
                "note": "A long right-hander taken almost flat out. Hard work for drivers' necks."
            },
            {
                "name": "Turn 10 (La Caixa)",
                "famous": true,
                "note": "Slow left hairpin at the end of the back straight. The second-best place to pass, which isn't saying much."
            },
            {
                "name": "Final corner",
                "famous": false,
                "note": "Fast right onto the main straight again since the chicane came out in 2023."
            }
        ],
        "moments": [
            {
                "season": 2016,
                "title": "Verstappen wins on his Red Bull debut",
                "body": "Moved up from Toro Rosso days earlier, Max Verstappen won at 18 after both Mercedes crashed into each other on lap one. The youngest Grand Prix winner ever.",
                "video": "https://www.youtube.com/watch?v=hohuswdeznA"
            }
        ],
        "history": [
            {
                "period": "1991",
                "body": "Opened, and hosted the Spanish Grand Prix every year up to 2025."
            },
            {
                "period": "2007",
                "body": "A chicane was added before the last corner to help overtaking. It didn't help."
            },
            {
                "period": "2023",
                "body": "Chicane removed; the fast final corner is back."
            },
            {
                "period": "2026",
                "body": "The Spanish GP moved to Madrid. Barcelona now hosts the Barcelona-Catalunya Grand Prix."
            }
        ]
    },
