    "guide": {
        "summary": "The Green Hell: more than 22 km of forest road, nicknamed by Jackie Stewart.",
        "character": "A lap of the Nordschleife took around seven minutes and climbed and dropped through the Eifel forest. Too long to marshal properly and too fast to crash safely. F1 left it in 1976 and later raced on the modern GP-Strecke next door.",
        "corners": [
            {
                "name": "Karussell",
                "famous": true,
                "note": "A banked hairpin where drivers dropped a wheel into the concrete gutter and held on."
            }
        ],
        "moments": [
            {
                "season": 1976,
                "title": "Lauda's crash",
                "body": "In 1976 Niki Lauda crashed and his Ferrari caught fire. Other drivers pulled him out of the car. He was racing again six weeks later."
            }
        ],
        "history": [
            {
                "period": "1927",
                "body": "The Nürburgring opened."
            },
            {
                "period": "1957",
                "body": "Juan Manuel Fangio won after a pit stop left him almost a minute behind, breaking the lap record again and again."
            },
            {
                "period": "1976",
                "body": "Last Grand Prix on the Nordschleife."
            },
            {
                "period": "1984",
                "body": "F1 returned on the new, much shorter GP-Strecke."
            }
        ],
        "leftCalendar": "Safety. After Lauda's 1976 crash, F1 stopped racing on the Nordschleife and the German Grand Prix moved to Hockenheim. The Nürburgring came back with the GP-Strecke, last used in 2020."
    },
    "sources": [
        {
            "title": "Nürburgring Nordschleife circuit guide",
            "url": "https://f1-circuits.com/historical-circuits/nurburgring-nordschleife",
